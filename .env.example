# Copy to .env and fill in. Without both keys the game runs in DEMO mode (bundled cases).
NEBIUS_API_KEY=
TAVILY_API_KEY=

# Optional overrides
# PORT=8787
# HOST=127.0.0.1   # listen only on localhost (recommended behind nginx)
# MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
# MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Cost guard: max NEW live cases (replays and preset cases are free)
# LIVE_CASES_PER_DAY=10
# LIVE_CASES_PER_MONTH=100
# LIVE_CASES_PER_IP_PER_HOUR=3
# LIVE_PRESETS=1          # also run the preset rumors live instead of using bundled data
# NEMOTRON_ENABLE_THINKING=1   # let Nemotron reason before answering (slower, uses more tokens)
# HIDE_BUNDLED_CASES=1  # in LIVE mode, show only the rumors from rumors.txt
# RUMOR_LIST=/path/to/rumors.txt
